{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mawaqit-desktop",
  "version": "0.5.0",
  "identifier": "com.bilel.mawaqit-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mawaqit Desktop",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560
      },
      {
        "label": "glance",
        "title": "Mawaqit",
        "width": 340,
        "height": 300,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "url": "index.html?glance"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
